# =========================================================================
# 라 린느 옴므 프론트엔드 환경 변수 예시
# 이 파일을 복사해 '.env' 파일을 만든 뒤 실제 값을 채워 넣으세요.
# (.env 는 저장소에 올라가지 않습니다)
# =========================================================================

# 백엔드 API 주소 (끝에 슬래시를 붙이지 마세요)
VITE_API_URL=http://localhost:8080

# 토스페이먼츠 결제창 클라이언트 키
#  - 이 키는 브라우저에 노출되어도 되는 공개 키입니다. (시크릿 키는 절대 여기 넣지 마세요)
#  - 값이 비어 있으면 결제 화면에서 '온라인 결제' 선택지가 표시되지 않고 무통장입금만 노출됩니다.
#  - 테스트 키와 운영 키를 이 값만 바꿔서 전환합니다.
VITE_TOSS_CLIENT_KEY=
